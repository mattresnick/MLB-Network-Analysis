{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "setup: venv+deps (MLB)",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder:MLB-Network-Analysis}\\scripts\\setup-venv.ps1"
			],
			"problemMatcher": []
		},
		{
			"label": "setup: venv+deps (MLB) [recreate]",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder:MLB-Network-Analysis}\\scripts\\setup-venv.ps1",
				"-Recreate"
			],
			"problemMatcher": []
		},
		{
			"label": "setup: conda env (MLB) [recreate]",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder:MLB-Network-Analysis}\\scripts\\setup-venv.ps1",
				"-Recreate",
				"-UseConda"
			],
			"problemMatcher": []
		},
		{
			"label": "run: scrape 2024 (MLB)",
			"type": "shell",
			"command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
			"args": [
				"${workspaceFolder}\\cli.py",
				"--config",
				"${workspaceFolder}\\config\\example_2024.json",
				"scrape"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "run: full 2024 (MLB)",
			"type": "shell",
			"command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
			"args": [
				"${workspaceFolder}\\run_config.py",
				"--config",
				"${workspaceFolder}\\config\\example_2024.json"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		}
	]
}