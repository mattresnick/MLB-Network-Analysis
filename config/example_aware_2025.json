{
  "pipeline": {
    "years": [2025],
    "allow_2020": false,
    "dry_run": false,
    "score_types": ["aware"],
    "validation_folds": 5,
    "validation": {
      "aucMode": "balanced-negatives",
      "negatives_per_positive": 1,
      "auto_flip": true,
      "extra": {
        "opponent_blockout": true,
        "temperature_logloss": true,
        "statcast_logloss": true,
        "baseline_auc": true
      }
    },
    "ranking": {
      "top_n": 25,
      "scale_ranks": false,
      "output_levels": true,
      "aware_lambda": 1.0,
      "aware_harmonic": true,
      "aware_shrink": true,
      "aware_shrink_mode": "se_based",
      "aware_shrink_k": 150,
      "aware_shrink_k_pitcher": 400,
      "aware_use_covariates": true,
      "aware_covariates_basic": true
    },
    "edges": { "force": false },
    "paths": {
      "raw_data_dir": "At Bats/general_data",
      "output_dir": "outputs_aware_full"
    },
    "output": { "formats": ["csv"] },
    "logging": { "level": "INFO", "progress": true },
    "scrape": { "force": false, "skip": true },
    "scenarios": { "A_include_milb": true, "mlb_only_leaderboard": true }
  }
}
