{
  "pipeline": {
    "years": [2024],
    "score_types": ["aware"],
    "validation_folds": 5,
    "validation": {
      "aucMode": "balanced-negatives",
      "negatives_per_positive": 1,
      "auto_flip": true,
      "extra": {
        "temperature_logloss": false,
        "statcast_logloss": false,
        "baseline_auc": true,
        "opponent_blockout": true,
        "only_baseline": false
      }
    },
    "ranking": {
      "top_n": 50,
      "scale_ranks": false,
      "output_levels": true,
      "aware_lambda": 0.0,
      "aware_harmonic": false,
      "aware_shrink": true,
      "aware_shrink_mode": "se_based",
      "aware_use_covariates": true,
      "aware_covariates_basic": true,
      "aware_shrink_k": 150,
      "aware_shrink_k_pitcher": 400
    },
    "paths": {
      "raw_data_dir": "At Bats/general_data",
      "output_dir": "outputs_aware_full"
    },
    "processing": {
      "vectorized": true,
      "unipartite_metric": "sum"
    },
    "caching": {
      "enabled": false,
      "manifest": "outputs_aware_full/manifest.json"
    },
    "output": {
      "formats": ["csv"]
    },
    "edges": {
      "force": true
    },
    "logging": {
      "level": "INFO",
      "progress": true
    },
    "scrape": {
      "force": false,
      "skip": true
    },
    "analysis": {
      "rank_correlation": {"enabled": false, "pairs": "adjacent"},
      "ops_correlation": {"enabled": false},
      "iterative_rank_weighted": {"enabled": false, "passes": 0, "metric": "sum", "evaluate_auc": false},
      "next_year_validation": {"enabled": false}
    }
  }
}
