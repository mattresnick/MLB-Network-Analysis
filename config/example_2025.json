{
  "pipeline": {
    "validation": { "aucMode": "legacy", "modes": {"edge_block": true, "pa_block": false, "loeo": true} },
    "processing": { "unipartite_metric": "rate" },
    "years": [2025],
    "allow_2020": false,
    "dry_run": false,
    "score_types": ["frequency"],
    "validation_folds": 5,
    "ranking": {"top_n": 25, "scale_ranks": true, "output_levels": true},
    "paths": {
      "raw_data_dir": "At Bats/general_data",
      "output_dir": "outputs"
    },
    "edges": { "force": true },
    "scrape": { "force": false },
    "output": {"formats": ["csv"]},
    "analysis": { "k_sweep": {"enabled": false} }
  },
  "logging": {"level": "INFO", "progress": true}
}
