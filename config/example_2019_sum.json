{
  "pipeline": {
    "validation": { "aucMode": "legacy" },
    "processing": { "unipartite_metric": "sum" },
    "years": [2019],
    "allow_2020": false,
    "dry_run": false,
    "score_types": ["frequency"],
    "validation_folds": 5,
    "ranking": {"top_n": 25, "scale_ranks": true, "output_levels": true},
    "paths": {
      "raw_data_dir": "At Bats/general_data",
      "output_dir": "outputs"
    },
    "edges": { "force": false },
    "output": {"formats": ["csv"]}
  },
  "logging": {"level": "INFO", "progress": true}
}
