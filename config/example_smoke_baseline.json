{
  "pipeline": {
    "validation": {
      "aucMode": "balanced-negatives",
      "negatives_per_positive": 1,
      "auto_flip": true,
      "extra": {
        "temperature_logloss": false,
        "statcast_logloss": false,
        "baseline_auc": true
      }
    },
    "processing": { "unipartite_metric": "rate" },
    "years": [2024],
    "allow_2020": false,
    "dry_run": false,
    "score_types": ["frequency"],
    "validation_folds": 2,
    "ranking": {"top_n": 5, "scale_ranks": false, "output_levels": false},
    "paths": {
      "raw_data_dir": "At Bats/general_data",
      "output_dir": "outputs_smoke"
    },
    "output": {"formats": ["csv"]}
  },
  "logging": {"level": "INFO", "progress": true}
}
